    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@ansible/portal-plugin-node": "workspace:^",
    "@backstage/backend-plugin-api": "^1.8.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@types/express": "^5.0.3",
    "jest": "^29.7.0"
  },
  "files": [
    "dist"
  ]

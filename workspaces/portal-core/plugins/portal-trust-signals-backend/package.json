{
  "name": "@ansible/portal-trust-signals-backend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Portal SDK quickstart backend for organization-scoped trust signals.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"

{
  "name": "@ansible/portal-hello-world",
  "version": "0.1.0",
  "description": "A minimal native Portal plugin that demonstrates a page and SDK contribution.",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "backstage": {
    "role": "frontend-plugin"
  },
  "sideEffects": false,
  "configSchema": "config.d.ts",
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@ansible/portal-extension-api": "workspace:^",
    "@ansible/portal-extension-common": "workspace:^",
    "@backstage/core-compat-api": "0.5.11",
    "@backstage/frontend-plugin-api": "0.17.1",
    "@material-ui/icons": "^4.9.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@types/react": "^18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "files": [
    "config.d.ts",
    "dist"
  ]
}
